# Hugging Face Configuration & Secrets (Template)
# Copy this file to .env and fill in your actual credentials
HF_TOKEN="hf_your_write_token_here"
HF_REPO_ID="your-username/malayalam-speech-studio-models"

# Client accessible environment variables (Expo)
EXPO_PUBLIC_HF_USERNAME="your-username"
EXPO_PUBLIC_HF_REPO_ID="your-username/malayalam-speech-studio-models"
